{# 2. Add conditional top-level fields #}
{% if 'id' in data and data['id'] is not none %}
    {% do contract.update({'id': data['id']}) %}
{% endif %}

{% if 'data product display name' in data and data['data product display name'] is not none %}
    {% do contract.update({'name': data['data product display name']}) %}
{% endif %}

{% if 'Data Product Lifecycle' in data and data['Data Product Lifecycle'].value is not none %}
    {% do contract.update({'status': data['Data Product Lifecycle'].value}) %}
{% endif %}

{% if 'JIRA or JIRA Align Link' in data and data['JIRA or JIRA Align Link'].value is not none %}
    {% do contract.update({'authoritativeDefinitions': [
        {
            "type": "JIRA or JIRA Align Link",
            "url": data['JIRA or JIRA Align Link'].value | extract_href
        }
    ]}) %}
{% endif %}

{% if 'Data Product Business Name' in data and data['Data Product Business Name'] is not none and data['Data Product Business Name'].name is not none %}
    {% do contract.update({'dataProduct': data['Data Product Business Name'].value}) %}
{% endif %}

