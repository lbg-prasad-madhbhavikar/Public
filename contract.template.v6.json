    {% do contract.update({'domain': data['owning platform']}) %}
{% endif %}

{% if 'business domain' in data and data['business domain'] is not none %}
    {% do contract.update({'community': data['business domain']}) %}
{% endif %}

{# 3. Build 'description' object conditionally #}
{# This object itself is static, but its internal properties are conditional #}
{% set description_obj = {
    'usage': 'Intended usage of the dataset',
    'limitations': ''
} %}
{% if 'Consumer Use Case & Business Value' in data and data['Consumer Use Case & Business Value'].value is not none %}
    {% do description_obj.update({'purpose': data['Consumer Use Case & Business Value'].value}) %}
{% endif %}
{% set desc_custom_props = [] %}
{% if 'Description' in data and data['Description'].value is not none %}
    {% do desc_custom_props.append({'property': 'detailedDescription', 'value': data['Description'].value}) %}
{% endif %}
{% if desc_custom_props | length > 0 %}
    {% do description_obj.update({'customProperties': desc_custom_props}) %}
{% endif %}
{% do contract.update({'description': description_obj}) %}


{# 4. Build 'schema' array conditionally #}
{#
"tags": [],
            "quality": [
                {
                    "businessImpact": "operational",
                    "description": "Not null check on all applicable attributes",
                    "dimension": "completeness",
                    "name": "notNullAttributeCheck",
                    "type": "custom",
                    "customProperties": [
                        {"property": "threshold", "value": "2%"},
                        {"property": "thresholdFailureAction", "value": "Hold failed records"},
                        {"property": "failureTicketSeverity", "value": "P2"}
                    ]
                }
            ]
#}
{% set schema_list = [] %}
{% if 'Data Product contains Table' in data and data['Data Product contains Table'] is iterable %}
    {% for table in data['Data Product contains Table'] %}
        {% set table_obj = {
            "physicalType": "table"
        } %}

        {% if table['table'] is not none %}
            {% do table_obj.update({'physicalName': table['table'] | extract_last_value}) %}
        {% endif %}

        {% if 'Data Product contains Schema' in data and data['Data Product contains Schema'][0] is defined and data['Data Product contains Schema'][0].value is not none %}
            {% do table_obj.update({'businessName': data['Data Product contains Schema'][0].value | extract_last_value}) %}
        {% endif %}

        {% if 'Description' in table and table['Description'] is not none %}
            {% do table_obj.update({'description': table['Description']}) %}
        {% endif %}

        {% if 'DataGranularityDescription' in table and table['DataGranularityDescription'] is not none %}
            {% do table_obj.update({'dataGranularityDescription': table['DataGranularityDescription']}) %}
        {% endif %}

        {# 4a. Build 'properties' (columns) array conditionally #}
        {#
        "tags": [],
                    "quality": [
                        {
                            "businessImpact": "operational",
                            "description": "Not null check on all applicable attributes",
                            "dimension": "completeness",
                            "name": "notNullAttributeCheck",
                            "type": "custom",
                            "customProperties": [
                                {"property": "threshold", "value": "2%"},
                                {"property": "thresholdFailureAction", "value": "Hold failed records"},
                                {"property": "failureTicketSeverity", "value": "P2"}
                            ]
                        },
                        {
                            "businessImpact": "operational",
                            "description": "Unique key check",
                            "dimension": "uniqueness",
                            "name": "UKCheck",
                            "type": "custom",
                            "customProperties": [
                                {"property": "threshold", "value": "1%"},
                                {"property": "thresholdFailureAction", "value": "Hold failed records"},
                                {"property": "failureTicketSeverity", "value": "P2"}
                            ]
                        },
                        {
                            "businessImpact": "operational",
                            "description": "Attribute pattern check using the 'attributePattern' custom property of attributes in the Schema",
                            "dimension": "consistency",
                            "name": "patternCheck",
                            "type": "custom",
                            "customProperties": [
                                {"property": "threshold", "value": "5%"},
                                {"property": "thresholdFailureAction", "value": "Hold failed records"},
                                {"property": "failureTicketSeverity", "value": "P2"}
                            ]
                        }
                    ]
        #}
        {% set columns_list = [] %}
        {% if 'columns' in table and table['columns'] is iterable %}
            {% for column in table['columns'] %}
                {% set col_obj = {
                    "logicalTypeOptions": {},
                    "partitioned": false,
                    "partitionKeyPosition": -1,
                    "criticalDataElement": false
                } %}

                {% if 'name' in column and column['name'] is not none %}
                    {% do col_obj.update({'name': column['name'] | extract_last_value}) %}
                    {% do col_obj.update({'physicalName': column['name'] | extract_last_value}) %}
                {% endif %}

                {% set is_primary_key = (column['specs'] | selectattr('name', 'equalto', 'Is Primary Key') | map(attribute='value') | list | first | default(false, true)) %}
                {% do col_obj.update({'primaryKey': is_primary_key}) %}
                
                {% if is_primary_key %}
                    {% set col_pos = (column['specs'] | selectattr('name', 'equalto', 'Column Position') | map(attribute='value') | list | first) %}
                    {% if col_pos is not none %}
                         {% do col_obj.update({'primaryKeyPosition': col_pos}) %}
                    {% else %}
                         {% do col_obj.update({'primaryKeyPosition': -1}) %}
                    {% endif %}
                {% else %}
                    {% do col_obj.update({'primaryKeyPosition': -1}) %}
                {% endif %}

                {% set logical_type = (column['specs'] | selectattr('name', 'equalto', 'is Logically represented by') | map(attribute='value') | list | first) %}
                {% if logical_type is not none %}
                    {% do col_obj.update({'logicalType': logical_type}) %}
                {% endif %}

                {% set physical_type = (column['specs'] | selectattr('name', 'equalto', 'Technical Data Type') | map(attribute='value') | list | first) %}
                {% if physical_type is not none %}
                    {% do col_obj.update({'physicalType': physical_type}) %}
                {% endif %}

                {% set is_nullable = (column['specs'] | selectattr('name', 'equalto', 'Is Nullable') | map(attribute='value') | list | first) %}
                {% if is_nullable is not none %}
                    {% do col_obj.update({'required': not is_nullable}) %}
                {% endif %}

                {% set col_desc = (column['specs'] | selectattr('name', 'equalto', 'Description') | map(attribute='value') | list | first) %}
                {% if col_desc is not none %}
                    {% do col_obj.update({'description': col_desc}) %}
                {% endif %}
                
                {% set classification = (column['specs'] | selectattr('name', 'equalto', 'Security Classification') | map(attribute='value') | list | first) %}
                {% if classification is not none %}
                    {% do col_obj.update({'classification': classification}) %}
                {% endif %}

                {# 4b. Build column 'properties' array conditionally #}
                {% set col_props_list = [] %}
                {% if 'Data Product contains Schema' in data and data['Data Product contains Schema'][0].value is not none %}
                    {% do col_props_list.append({'property': 'schemaName', 'value': data['Data Product contains Schema'][0].value | extract_last_value}) %}
                {% endif %}

                {% set name_prop = (column['specs'] | selectattr('name', 'equalto', 'Description from source system') | map(attribute='value') | list | first) %}
                {% if name_prop is not none %}
                    {% do col_props_list.append({'property': 'name', 'value': name_prop}) %}
                {% endif %}
                
                {% set desc_prop = (column['specs'] | selectattr('name', 'equalto', 'Description') | map(attribute='value') | list | first) %}
                {% if desc_prop is not none %}
                    {% do col_props_list.append({'property': 'description', 'value': desc_prop}) %}
                {% endif %}

                {% set seq_prop = (column['specs'] | selectattr('name', 'equalto', 'Column Position') | map(attribute='value') | list | first) %}
                {% if seq_prop is not none %}
                    {% do col_props_list.append({'property': 'attributeSequence', 'value': seq_prop}) %}
                {% endif %}

                {% do col_props_list.append({'property': 'anonymizationStrategy', 'value': 'none'}) %} {# Static #}

                {% set personal_prop = (column['specs'] | selectattr('name', 'equalto', 'Personal Data?') | map(attribute='value') | list | first) %}
                {% if personal_prop is not none %}
                    {% do col_props_list.append({'property': 'personalDataIndicator', 'value': personal_prop}) %}
                {% endif %}

                {% if col_props_list | length > 0 %}
                    {% do col_obj.update({'properties': col_props_list}) %}
                {% endif %}

                {% do columns_list.append(col_obj) %}
            {% endfor %}
        {% endif %}
        {% if columns_list | length > 0 %}
            {% do table_obj.update({'properties': columns_list}) %}
        {% endif %}

        {% do schema_list.append(table_obj) %}
    {% endfor %}
{% endif %}
{% if schema_list | length > 0 %}
    {% do contract.update({'schema': schema_list}) %}
{% endif %}


