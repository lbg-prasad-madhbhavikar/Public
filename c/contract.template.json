{
    "version": "0.1.0",
    "kind": "DataContract",
    "apiVersion": "v3.0.2",
    "id": "{{ data['id'] }}",
    "name": "{{ data['data product display name'] }}",
    "tenant": "",
    "tags": [
        ""
    ],
    "status": "{{ data['Data Product Lifecycle'].value }}",
    "servers": [{
        "server": "ap-edhcon-prd-01-2cad-10",
        "type": "bigquery",
        "project": "ap-edhcon-prd-01-2cad-10",
        "dataset": "ap_edhcon_prd_01_bqd_euwe2_oceant24stg_010"
    }],
    "authoritativeDefinitions": [
        {
            "type": "JIRA or JIRA Align Link",
            "url": "{{ data['JIRA or JIRA Align Link'].value | extract_href }}"
        }
    ],
    "dataProduct": "{{ data['Data Product Business Name'].name if data['Data Product Business Name'] is defined and data['Data Product Business Name'].name is not none else ''}}",
    "description": {
        "usage": "Intended usage of the dataset",
        "purpose": "{{ data['Consumer Use Case & Business Value'].value }}",
        "limitations": "",
        "customProperties" : [
            {
                "property": "detailedDescription",
                "value": "{{ data['Description'].value }}"
            }
        ]
    },
    "domain": "{{ data['owning platform'] }}",
    "community": "{{ data['business domain'] }}",
    "slaDefaultElement": null,
    "schema": [
        {% for i in range(data['Data Product contains Table'] | length) %}
        {
            {#"logicalType": "",#}
            "physicalName": "{{ data['Data Product contains Table'][i]['table'] | extract_last_value }}",
            "physicalType": "table",
            "businessName": "{{ data['Data Product contains Schema'][0].value | extract_last_value if data['Data Product contains Schema'][0] is defined else '' }}",
            "description": "{{ data['Data Product contains Table'][i]['Description'] if data['Data Product contains Table'][i]['Description'] is defined else '' }}",
            "tags": [],
            {% if 'Data Product contains Table' in data and data['Data Product contains Table'][i]['DataGranularityDescription'] is not none %}
            "dataGranularityDescription": "{{ data['Data Product contains Table'][i]['DataGranularityDescription'] }}",
            {% endif %}
            "properties": [
                {% for j in range(data['Data Product contains Table'][i]['columns'] | length) %}
                {
                    "name": "{{ data['Data Product contains Table'][i]['columns'][j]['name'] | extract_last_value }}",
                    "primaryKey": {{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Is Primary Key')  | map(attribute='value') | list | first}},
                    {% set is_primary_key = data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Is Primary Key') | map(attribute='value') | list | first | default(false, true)%}
                    "primaryKeyPosition": {% if is_primary_key %} {{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Column Position') | map(attribute='value') | list | first }}{% else %}-1{% endif %},
                    "logicalType": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'is Logically represented by') | map(attribute='value') | list | first }}",
                    "logicalTypeOptions": {},
                    "physicalType": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Technical Data Type') | map(attribute='value') | list | first }}",
                    "physicalName": "{{ data['Data Product contains Table'][i]['columns'][j]['name'] | extract_last_value }}",
                    "required": {{ not (data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Is Nullable') | map(attribute='value') | list | first) }},
                    "description": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Description') | map(attribute='value') | list | first }}",
                    "partitioned": false,
                    "partitionKeyPosition": -1,
                    "criticalDataElement": false,
                    "tags": [],
                    "classification": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Security Classification') | map(attribute='value') | list | first }}",
                    "quality": [
                        {
                            "businessImpact": "operational",
                            "description": "Not null check on all applicable attributes",
                            "dimension": "completeness",
                            "name": "notNullAttributeCheck",
                            "type": "custom",
                            "customProperties": [
                                {
                                    "property": "threshold",
                                    "value": "2%"
                                },
                                {
                                    "property": "thresholdFailureAction",
                                    "value": "Hold failed records"
                                },
                                {
                                    "property": "failureTicketSeverity",
                                    "value": "P2"
                                }
                            ]
                        },
                        {
                            "businessImpact": "operational",
                            "description": "Unique key check",
                            "dimension": "uniqueness",
                            "name": "UKCheck",
                            "type": "custom",
                            "customProperties": [
                                {
                                    "property": "threshold",
                                    "value": "1%"
                                },
                                {
                                    "property": "thresholdFailureAction",
                                    "value": "Hold failed records"
                                },
                                {
                                    "property": "failureTicketSeverity",
                                    "value": "P2"
                                }
                            ]
                        },
                        {
                            "businessImpact": "operational",
                            "description": "Attribute pattern check using the 'attributePattern' custom property of attributes in the Schema",
                            "dimension": "consistency",
                            "name": "patternCheck",
                            "type": "custom",
                            "customProperties": [
                                {
                                    "property": "threshold",
                                    "value": "5%"
                                },
                                {
                                    "property": "thresholdFailureAction",
                                    "value": "Hold failed records"
                                },
                                {
                                    "property": "failureTicketSeverity",
                                    "value": "P2"
                                }
                            ]
                        }
                    ],
                    "properties": [
                        {
                            "property": "schemaName",
                            "value": "{{ data['Data Product contains Schema'][0].value | extract_last_value }}"
                        },
                        {
                            "property": "name",
                            "value": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Description from source system') | map(attribute='value') | list | first }}"
                        },
                        {
                            "property": "description",
                            "value": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Description') | map(attribute='value') | list | first }}"
                        },
                        {
                            "property": "attributeSequence",
                            "value": "{{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Column Position') | map(attribute='value') | list | first }}"
                        },
                        {
                            "property": "anonymizationStrategy",
                            "value": "none"
                        },
                        {
                            "property": "personalDataIndicator",
                            "value": {{ data['Data Product contains Table'][i]['columns'][j]['specs'] | selectattr('name', 'equalto', 'Personal Data?') | map(attribute='value') | list | first }}
                        }
                    ]
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ],
            "quality": [
                {
                    "businessImpact": "operational",
                    "description": "Not null check on all applicable attributes",
                    "dimension": "completeness",
                    "name": "notNullAttributeCheck",
                    "type": "custom",
                    "customProperties": [
                        {
                            "property": "threshold",
                            "value": "2%"
                        },
                        {
                            "property": "thresholdFailureAction",
                            "value": "Hold failed records"
                        },
                        {
                            "property": "failureTicketSeverity",
                            "value": "P2"
                        }
                    ]
                }
            ]

        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
